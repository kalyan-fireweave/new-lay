# Local stack. pnpm dev uses these origins and the local compose file.
KEEL_ENV=local
KEEL_WEB_ORIGIN=http://127.0.0.1:4100
KEEL_API_ORIGIN=http://127.0.0.1:4101
KEEL_STUDIO_ORIGIN=http://127.0.0.1:4102
DATABASE_URL=postgres://keel:keel@127.0.0.1:41532/keel
KEEL_SESSION_SECRET=
KEEL_SEED_PASSWORD=keel-local-only
KEEL_SEED=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4418

# Collector vendor: debug, openobserve, datadog, or sentry.
# debug keeps both pipelines in the collector log and needs no account.
KEEL_COLLECTOR_VENDOR=debug

# Application account. OpenObserve cloud looks like this:
#   KEEL_VENDOR_APP_ENDPOINT=https://api.openobserve.ai/api/<org>
#   KEEL_VENDOR_APP_API_KEY=Basic <base64 of email:password>
#   KEEL_VENDOR_APP_SITE=<org>
# The key is the full Authorization header value, not the raw password.
# Leave the infrastructure lines empty to send infra to this same account.
KEEL_VENDOR_APP_ENDPOINT=
KEEL_VENDOR_APP_API_KEY=
KEEL_VENDOR_APP_SITE=

# Infrastructure account. Fill these for a different account.
# The same values as the application account are allowed.
KEEL_VENDOR_INFRA_ENDPOINT=
KEEL_VENDOR_INFRA_API_KEY=
KEEL_VENDOR_INFRA_SITE=

# Production stack only. pnpm prod reads these and ignores the local origins above.
# KEEL_ENV in this file stays local. The server env file sets KEEL_ENV=production.
KEEL_IMAGE_TAG=
KEEL_HTTP_PUBLISH=127.0.0.1:8080
KEEL_PROD_WEB_ORIGIN=https://keel.example
KEEL_PROD_API_ORIGIN=https://keel.example
KEEL_PROD_STUDIO_ORIGIN=https://keel.example
KEEL_PROD_SESSION_SECRET=
KEEL_PROD_SEED=0
KEEL_PROD_SEED_PASSWORD=

# FireWeave remote flag evaluation — issue keys in the project settings portal
FIREWEAVE_KEY=
